<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/icalsender/db" VERSION="20260817" COMMENT="XMLDB file for Moodle local/icalsender"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd"
>
  <TABLES>
    <TABLE NAME="local_icalsender_ics_events" COMMENT="This table contains list events for which an iCAL event was sent">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="eventid" TYPE="int" LENGTH="10"  NOTNULL="true" SEQUENCE="false" COMMENT="The id of the event"/>
        <FIELD NAME="eventname" TYPE="text"  NOTNULL="false" SEQUENCE="false" COMMENT="The name of the event"/>
        <FIELD NAME="seqnum" TYPE="int"  LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="The sequence number used in the iCal event"/>
        <FIELD NAME="senttime" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Time iCAL event was sent"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
    </TABLE>
    <TABLE NAME="local_icalsender_gcal_events" COMMENT="Maps Moodle events to events created in Google Calendar">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="eventid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Moodle calendar event ID"/>
        <FIELD NAME="calendarid" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false" COMMENT="Google calendar ID"/>
        <FIELD NAME="googleeventid" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false" COMMENT="Google Calendar event ID"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="eventid" UNIQUE="true" FIELDS="eventid"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_icalsender_att_users" COMMENT="Tracks Attendance ICS delivery per user">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="eventid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Moodle calendar event ID"/>
        <FIELD NAME="sessionid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Attendance session ID"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Moodle user ID"/>
        <FIELD NAME="statusid" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="Attendance status ID"/>
        <FIELD NAME="active" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1" SEQUENCE="false" COMMENT="Whether the user currently has an active Attendance invite"/>
        <FIELD NAME="seqnum" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Last iCalendar sequence number sent to this user"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="sessionuserid" UNIQUE="true" FIELDS="sessionid,userid"/>
        <INDEX NAME="eventid" UNIQUE="false" FIELDS="eventid"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_icalsender_att_sessions" COMMENT="Tracks Attendance calendar event metadata per session">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="sessionid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Attendance session ID"/>
        <FIELD NAME="eventid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Moodle calendar event ID or generated fallback event ID"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Moodle course ID"/>
        <FIELD NAME="eventname" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Calendar event name"/>
        <FIELD NAME="description" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Calendar event description"/>
        <FIELD NAME="location" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false" COMMENT="Calendar event location"/>
        <FIELD NAME="timestart" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Calendar event start time"/>
        <FIELD NAME="timeduration" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Calendar event duration"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="sessionid" UNIQUE="true" FIELDS="sessionid"/>
        <INDEX NAME="eventid" UNIQUE="false" FIELDS="eventid"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
